{
  // Worker del sitio horsepos.com (mismo nombre que el existente: no crea uno nuevo).
  "name": "broad-frog-1e4b",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Solo /api/* pasa por el código; todo lo demás sale directo de los archivos estáticos.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // Conserva las variables y secretos cargados desde el panel de Cloudflare.
  "keep_vars": true,
  // ID de la aplicación de Mercado Pago "Nodo Sur POS" (no es secreto). El secreto va aparte: MP_CLIENT_SECRET, cargado en Cloudflare.
  "vars": { "MP_CLIENT_ID": "7309232869105658" },
  "observability": { "enabled": true },
  // Limpieza diaria, 12:00 UTC (09:00 Argentina). Solo actúa si D1 y Mercado Pago están configurados.
  "triggers": { "crons": ["0 12 * * *"] },
  // Instaladores y actualizaciones del sistema POS (bucket privado; hay que crearlo antes en R2).
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "nodosur-releases" }],
  // Aviso en vivo de la sync entre dispositivos: un Durable Object por cuenta, con WebSockets que hibernan (un
  // socket quieto no consume cómputo). Está en el plan gratis (solo la versión con SQLite).
  "durable_objects": { "bindings": [{ "name": "SYNC_HUB", "class_name": "SyncHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncHub"] }],
  // Base D1 (usuarios y uso). El ID no es secreto.
  "d1_databases": [
    { "binding": "DB", "database_name": "nodosur", "database_id": "285a2863-0227-4056-98f8-9156fc84455e" }
  ]
}
